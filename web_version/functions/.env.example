# EL-KKETA Cloud Functions - Environment Variables
# انسخ هذا الملف باسم .env واملأ القيم الحقيقية

# ─── Telegram Bot ───────────────────────────────
# احصل عليه من @BotFather على تيليجرام
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUVwxyz

# ─── Telegram Chat ID ───────────────────────────
# افتح: https://api.telegram.org/bot<TOKEN>/getUpdates
# بعد ما تبعت رسالة للبوت، ستجد "id" داخل "chat"
TELEGRAM_CHAT_ID=123456789
