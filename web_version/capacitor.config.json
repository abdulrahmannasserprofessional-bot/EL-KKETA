{
  "appId": "com.elkheta.app",
  "appName": "ELKHETA",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*.firebaseapp.com",
      "*.firebase.google.com",
      "*.googleapis.com",
      "*.google.com",
      "firebaseio.com",
      "*.firebaseio.com"
    ]
  }
}
