{
  "rules": {
    ".read": false,
    ".write": false,

    "Students": {
      ".read": true,
      ".write": true,
      ".indexOn": ["email", "phone", "isBanned", "deviceId", "lastActive", "joinDate"],
      "$studentCode": {
        ".validate": "newData.hasChildren(['fullName']) && newData.child('fullName').isString()"
      }
    },

    "ActivationCodes": {
      ".read": true,
      ".write": true,
      ".indexOn": ["isUsed"]
    },

    "ActivatedCodes": {
      ".read": true,
      ".write": true,
      ".indexOn": ["isUsed"]
    },

    "Supervisors": {
      ".read": true,
      ".write": true,
      ".indexOn": ["isActive"]
    },

    "Lectures": {
      ".read": true,
      ".write": true
    },

    "Chapters": {
      ".read": true,
      ".write": true
    },

    "Content": {
      ".read": true,
      ".write": true
    },

    "Subjects": {
      ".read": true,
      ".write": true,
      ".indexOn": ["name", "order"]
    },

    "Exams": {
      ".read": true,
      ".write": true
    },

    "Announcements": {
      ".read": true,
      ".write": true,
      ".indexOn": ["createdAt", "batch"]
    },

    "Mistakes": {
      ".read": true,
      ".write": true,
      ".indexOn": ["studentCode", "subjectId"],
      "$mistakeId": {
        ".validate": "newData.hasChildren(['studentCode'])"
      }
    },

    "Leaderboard": {
      ".read": true,
      ".write": true,
      ".indexOn": ["score"]
    },

    "PushTokens": {
      ".read": false,
      ".write": true
    },

    "Settings": {
      ".read": true,
      ".write": true
    },

    "EmergencyIssues": {
      ".read": true,
      ".write": true,
      ".indexOn": ["status", "timestamp"]
    },

    "Community": {
      ".read": true,
      ".write": true,
      "$postId": {
        ".validate": "newData.hasChildren(['text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length <= 2000"
      }
    },

    "Chat": {
      ".read": true,
      ".write": true,
      "$messageId": {
        ".validate": "newData.hasChildren(['text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length <= 1000"
      }
    },

    "ActivityLogs": {
      ".read": true,
      ".write": true
    },

    "DeviceRequests": {
      ".read": true,
      ".write": true,
      ".indexOn": ["status", "studentCode", "timestamp"]
    },

    "SupportTickets": {
      ".read": true,
      ".write": true,
      ".indexOn": ["status", "priority", "studentCode", "timestamp"]
    },

    "PlatformIncidents": {
      ".read": true,
      ".write": true,
      ".indexOn": ["status", "severity", "timestamp"]
    }
  }
}
