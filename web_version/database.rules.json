{
  "rules": {
    ".read": false,
    ".write": false,

    "Students": {
      ".read": "auth != null",
      "$studentCode": {
        ".read": "auth != null && (auth.uid === $studentCode || root.child('Admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $studentCode || root.child('Admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['fullName'])",
        ".indexOn": ["email", "phone", "isBanned", "deviceId", "lastActive", "joinDate"]
      }
    },

    "ActivationCodes": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["isUsed"]
    },

    "ActivatedCodes": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["isUsed"]
    },

    "Supervisors": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["isActive", "pin"]
    },

    "Lectures": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$subject": {
        ".indexOn": ["chapter", "unlockTime"]
      }
    },

    "Subjects": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["name", "order"]
    },

    "Announcements": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdAt", "batch"]
    },

    "Mistakes": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["studentCode", "subjectId"]
    },

    "Leaderboard": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["score"]
    },

    "PushTokens": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "Settings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "Community": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "Chat": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
