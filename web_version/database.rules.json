{
  "rules": {
    "Students": {
      ".read": "true",
      ".write": "true",
      "$studentCode": {
        ".indexOn": ["email", "phone", "isBanned", "deviceId", "lastActive", "joinDate"]
      }
    },
    "ActivationCodes": {
      ".read": false,
      "$code": {
        ".read": "true",
        ".write": "true",
        ".indexOn": ["isUsed"]
      }
    },
    "ActivatedCodes": {
      ".read": false,
      "$code": {
        ".read": "true",
        ".write": "true",
        ".indexOn": ["isUsed"]
      }
    },
    "Supervisors": {
      ".read": false,
      "$supId": {
        ".read": "true",
        ".write": "true"
      }
    },
    "Lectures": {
      ".read": "true",
      ".write": "true",
      "$subject": {
        ".indexOn": ["chapter", "unlockTime"]
      }
    },
    "Subjects": {
      ".read": "true",
      ".write": "true",
      ".indexOn": ["name", "order"]
    },
    "Announcements": {
      ".read": "true",
      ".write": "true",
      ".indexOn": ["createdAt", "batch"]
    },
    "Community": {
      ".read": "true",
      ".write": "true"
    },
    "Mistakes": {
      ".read": "true",
      ".write": "true"
    },
    "Leaderboard": {
      ".read": "true",
      ".write": "true",
      ".indexOn": ["score"]
    },
    "Settings": {
      ".read": "true",
      ".write": "true"
    },
    "MailQueue": {
      ".read": "true",
      ".write": "true"
    },
    "$other": {
      ".read": "true",
      ".write": "true"
    }
  }
}
