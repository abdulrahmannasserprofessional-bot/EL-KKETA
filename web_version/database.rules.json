{
  "rules": {
    "Students": {
      // Allows anyone to read (for login checking) and write (for registration)
      ".read": "true",
      ".write": "true",
      "$studentCode": {
         ".indexOn": ["email", "phone"]
      }
    },
    "Leaderboard": {
      ".read": "true",
      ".write": "true",
      ".indexOn": ["score"]
    },
    "ActivatedCodes": {
      ".read": "true",
      ".write": "true",
      ".indexOn": ["isUsed"]
    },
    "ActivationCodes": {
      ".read": "true",
      ".write": "true",
      ".indexOn": ["isUsed"]
    },
    "MailQueue": {
      ".read": "true",
      ".write": "true"
    },
    // Keep other paths open for now as this is a client-side only app without Firebase Auth
    "$other": {
      ".read": "true",
      ".write": "true"
    }
  }
}
