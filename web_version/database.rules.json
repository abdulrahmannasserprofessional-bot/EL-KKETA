{
  "rules": {
    ".read": "true",
    ".write": "true",
    "Students": {
      ".indexOn": ["email", "phone", "isBanned", "deviceId", "lastActive", "joinDate"]
    },
    "ActivationCodes": {
      ".indexOn": ["isUsed"]
    },
    "ActivatedCodes": {
      ".indexOn": ["isUsed"]
    },
    "Supervisors": {
      ".indexOn": ["isActive", "pin"]
    },
    "Lectures": {
      "$subject": {
        ".indexOn": ["chapter", "unlockTime"]
      }
    },
    "Subjects": {
      ".indexOn": ["name", "order"]
    },
    "Announcements": {
      ".indexOn": ["createdAt", "batch"]
    },
    "Mistakes": {
      ".indexOn": ["studentCode", "subjectId"]
    },
    "Leaderboard": {
      ".indexOn": ["score"]
    }
  }
}
