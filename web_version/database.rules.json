{
  "rules": {
    ".read": false,
    ".write": false,

    "Students": {
      ".read": true,
      ".write": true,
      ".indexOn": ["email", "phone", "isBanned", "deviceId", "lastActive", "joinDate"]
    },

    "ActivationCodes": {
      ".read": true,
      ".write": true,
      ".indexOn": ["isUsed"]
    },

    "ActivatedCodes": {
      ".read": true,
      ".write": true,
      ".indexOn": ["isUsed"]
    },

    "Supervisors": {
      ".read": true,
      ".write": true,
      ".indexOn": ["isActive", "pin"]
    },

    "Lectures": {
      ".read": true,
      ".write": true,
      "$subject": {
        ".indexOn": ["chapter", "unlockTime"]
      }
    },

    "Subjects": {
      ".read": true,
      ".write": true,
      ".indexOn": ["name", "order"]
    },

    "Announcements": {
      ".read": true,
      ".write": true,
      ".indexOn": ["createdAt", "batch"]
    },

    "Mistakes": {
      ".read": true,
      ".write": true,
      ".indexOn": ["studentCode", "subjectId"]
    },

    "Leaderboard": {
      ".read": true,
      ".write": true,
      ".indexOn": ["score"]
    },

    "PushTokens": {
      ".read": true,
      ".write": true
    },

    "Settings": {
      ".read": true,
      ".write": true
    },

    "Community": {
      ".read": true,
      ".write": true
    },

    "Chat": {
      ".read": true,
      ".write": true
    }
  }
}
