{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "elkheta2026",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "python_manager/**",
      "delete_exams.js",
      "clear_exams.html",
      "dist/**",
      "build/**",
      "scratch/**",
      "electron-*.js",
      "*.dll",
      "*.bat",
      "android/**",
      "www/**",
      "test_db/**",
      "package.json",
      "package-lock.json",
      "capacitor.config.json",
      "temp_test*.js",
      "test_mistakes.js",
      "fix_chat_del.js",
      "make_notif.py",
      "send_notifications.py"
    ],
    "headers": [
    {
      "source": "downloads/ELKHETA-Setup-2.0.0.app",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"ELKHETA-Setup-2.0.0.exe\"" },
        { "key": "Content-Type", "value": "application/x-msdownload" }
      ]
    },
    {
      "source": "downloads/ELKHETA-v2.0.0.app",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"ELKHETA-v2.0.0.apk\"" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" }
      ]
    },
    {
      "source": "**",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "**/*.@(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "**/*.@(woff|woff2|ttf|otf|eot)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "**/*.@(png|jpg|jpeg|gif|webp|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "**/*.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
    "rewrites": [
      { "source": "/", "destination": "/index.html" }
    ]
  }
}
