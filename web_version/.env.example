# ==============================================================
# ELKHETA Web Platform — Environment Variables Template
# ==============================================================
# انسخ هذا الملف وسمّه .env (لا ترفعه على GitHub أبداً)
# تأكد أن .env مضاف في .gitignore
# ==============================================================

# --- Firebase Configuration ---
# احصل عليها من: Firebase Console > Project Settings > General
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# --- Backend API ---
# عنوان السيرفر الخلفي (MySQL API)
API_BASE_URL=https://your-backend-api.vercel.app/api

# --- Email / SMTP (للإشعارات بالبريد) ---
# استخدم App Password من Google وليس كلمة مرور Gmail العادية
SENDER_EMAIL=your-platform-email@gmail.com
SENDER_PASSWORD=your_google_app_password_16chars

# --- Firebase Admin SDK (للإشعارات Push) ---
# احصل عليه من: Firebase Console > Project Settings > Service accounts > Generate new private key
# احفظه كملف منفصل وأضفه في .gitignore
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# --- Security Settings ---
# PIN المدير الرئيسي — يُحفظ في Firebase فقط، لا يُكتب هنا
# ADMIN_MASTER_PIN=<لا تضعه هنا — اكتبه في Firebase/Settings/adminPin>
