<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- الإطار السداسي الذهبي للأيقونة -->
    <path
        android:strokeWidth="2.5"
        android:pathData="M54,12 L92,34 L92,74 L54,96 L16,74 L16,34 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="16"
                android:startY="12"
                android:endX="92"
                android:endY="96"
                android:type="linear">
                <item android:offset="0" android:color="#FFD700"/>
                <item android:offset="1" android:color="#D4AF37"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- رمز الـ K في المنتصف -->
    <path
        android:pathData="M42,32 L42,76 M42,54 L64,32 M54,54 L70,76"
        android:strokeWidth="7"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="42"
                android:startY="32"
                android:endX="70"
                android:endY="76"
                android:type="linear">
                <item android:offset="0" android:color="#FFD700"/>
                <item android:offset="1" android:color="#F1C40F"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>