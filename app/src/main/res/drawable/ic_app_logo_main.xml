<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- خلفية داكنة فخمة جداً -->
    <path
        android:pathData="M100,20 L170,55 L170,145 L100,180 L30,145 L30,55 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="20"
                android:endX="170"
                android:endY="180"
                android:type="linear">
                <item android:offset="0" android:color="#0F101A"/>
                <item android:offset="1" android:color="#1A1C2E"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- إطار سداسي ذهبي متدرج -->
    <path
        android:strokeWidth="3"
        android:pathData="M100,25 L165,58 L165,142 L100,175 L35,142 L35,58 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="35"
                android:startY="25"
                android:endX="165"
                android:endY="175"
                android:type="linear">
                <item android:offset="0" android:color="#D4AF37"/>
                <item android:offset="0.5" android:color="#FFD700"/>
                <item android:offset="1" android:color="#B8860B"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- رمز الـ K المميز (Modern K) -->
    <path
        android:pathData="M75,60 L75,140 M75,100 L115,60 M95,100 L125,140"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="75"
                android:startY="60"
                android:endX="125"
                android:endY="140"
                android:type="linear">
                <item android:offset="0" android:color="#FFD700"/>
                <item android:offset="1" android:color="#F1C40F"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- خطوط تزيينية سفلية -->
    <path
        android:fillColor="#FFD700"
        android:pathData="M70,155 L130,155 L125,160 L75,160 Z" />

</vector>