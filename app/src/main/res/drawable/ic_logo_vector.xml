<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- الخلفية: دائرة متدرجة -->
    <path
        android:pathData="M100,100m-90,0a90,90 0,1 1,180 0a90,90 0,1 1,-180 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="#1A237E"
                android:startColor="#3F51B5"
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="200"
                android:endY="200" />
        </aapt:attr>
    </path>

    <!-- رمز قبعة التخرج -->
    <path
        android:fillColor="#FFD700"
        android:pathData="M100,50 L40,80 L100,110 L160,80 Z" />
    <path
        android:fillColor="#FFD700"
        android:pathData="M60,90 L60,120 C60,120 80,140 100,140 C120,140 140,120 140,120 L140,90 L100,110 Z" />

    <!-- خط الخطة (Plan Path) -->
    <path
        android:pathData="M165,140 L140,165 L115,140"
        android:strokeWidth="5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M165,160 L140,185 L115,160"
        android:strokeWidth="5"
        android:strokeColor="#FFD700"
        android:strokeLineCap="round" />
</vector>