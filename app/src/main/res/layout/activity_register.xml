<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFF2F9">

    <!-- التدرج العلوي -->
    <View
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:background="@drawable/top_gradient_purple"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="عضوية جديدة ✨"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="45dp"
        app:cardCornerRadius="45dp"
        app:cardElevation="15dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="35dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginBottom="10dp"
                android:text="الاسم بالكامل"
                android:textColor="#9E9E9E"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:background="@drawable/bg_edittext_rounded"
                android:gravity="right|center_vertical"
                android:hint="أدخل اسمك الثلاثي"
                android:paddingHorizontal="20dp"
                android:textColor="#121421"
                android:textColorHint="#BCBCBC"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="10dp"
                android:text="رقم الهاتف"
                android:textColor="#9E9E9E"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:background="@drawable/bg_edittext_rounded"
                android:gravity="left|center_vertical"
                android:hint="01xxxxxxxxx"
                android:inputType="phone"
                android:paddingHorizontal="20dp"
                android:textColor="#121421"
                android:textColorHint="#BCBCBC"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGenerateCode"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="45dp"
                android:background="@drawable/bg_gradient_button"
                android:text="تفعيل حسابي الآن"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:text="العودة لتسجيل الدخول"
                android:textColor="#5E50DA"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>