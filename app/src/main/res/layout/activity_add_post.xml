<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إضافة منشور جديد"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etPostTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="عنوان المنشور"
        android:padding="12dp"
        android:background="@drawable/bg_edittext_rounded"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etPostDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="وصف المنشور"
        android:padding="12dp"
        android:gravity="top"
        android:minLines="3"
        android:background="@drawable/bg_edittext_rounded"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etPostUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="رابط المحتوى (اختياري)"
        android:padding="12dp"
        android:background="@drawable/bg_edittext_rounded"
        android:layout_marginBottom="12dp"/>

    <Spinner
        android:id="@+id/spinnerType"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnSavePost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="نشر الآن"
        android:backgroundTint="@color/design_default_color_primary"/>

</LinearLayout>
