<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121421">

    <!-- الهيدر العلوي -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/adminHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لوحة تحكم المنصة"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivAdminBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_edittext_rounded"
            android:backgroundTint="#1F2235"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adminHeader">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:paddingHorizontal="10dp"
            android:paddingBottom="80dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnManageSubjects"
                style="@style/AdminCardStyle">
                <LinearLayout style="@style/AdminCardInnerStyle">
                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_book_stack"
                        app:tint="#FFC107" />
                    <TextView
                        style="@style/AdminCardTextStyle"
                        android:text="إدارة المواد" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnManageStudents"
                style="@style/AdminCardStyle">
                <LinearLayout style="@style/AdminCardInnerStyle">
                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_students"
                        app:tint="#6C5CE7" />
                    <TextView
                        style="@style/AdminCardTextStyle"
                        android:text="حسابات الطلاب" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnUploadContent"
                style="@style/AdminCardStyle">
                <LinearLayout style="@style/AdminCardInnerStyle">
                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_upload"
                        app:tint="#FF4757" />
                    <TextView
                        style="@style/AdminCardTextStyle"
                        android:text="رفع المحتوى" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnManageCodes"
                style="@style/AdminCardStyle">
                <LinearLayout style="@style/AdminCardInnerStyle">
                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_lock"
                        app:tint="#2ECC71" />
                    <TextView
                        style="@style/AdminCardTextStyle"
                        android:text="إدارة الأكواد" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnActivatedCodes"
                style="@style/AdminCardStyle">
                <LinearLayout style="@style/AdminCardInnerStyle">
                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_students"
                        app:tint="#F1C40F" />
                    <TextView
                        style="@style/AdminCardTextStyle"
                        android:text="مراقبة التفعيل" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNotifications"
                style="@style/AdminCardStyle">
                <LinearLayout style="@style/AdminCardInnerStyle">
                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_bell"
                        app:tint="#E67E22" />
                    <TextView
                        style="@style/AdminCardTextStyle"
                        android:text="مركز التنبيهات" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnManageClasses"
                style="@style/AdminCardStyle">
                <LinearLayout style="@style/AdminCardInnerStyle">
                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_class"
                        app:tint="#00BCD4" />
                    <TextView
                        style="@style/AdminCardTextStyle"
                        android:text="إدارة الفصول" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSystemConfig"
                style="@style/AdminCardStyle">
                <LinearLayout style="@style/AdminCardInnerStyle">
                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_settings"
                        app:tint="#9B59B6" />
                    <TextView
                        style="@style/AdminCardTextStyle"
                        android:text="إعدادات النظام" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- بطاقة الترحيب العائمة -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWelcomeAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        app:cardBackgroundColor="#FFD700"
        app:cardCornerRadius="30dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="30dp"
            android:paddingVertical="12dp"
            android:text="مرحباً بك يا مدير المنصة ❤️"
            android:textColor="#121421"
            android:textSize="14sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>