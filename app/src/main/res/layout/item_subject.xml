<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardSubject"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp"
    app:cardPreventCornerOverlap="false"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clSubjectContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="185dp"
        android:padding="20dp">

        <!-- أيقونة خلفية باهتة لإعطاء عمق -->
        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:alpha="0.08"
            android:rotation="-20"
            android:src="@drawable/ic_book_stack"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.3"
            app:layout_constraintVertical_bias="1.3"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/ivSubjectIcon"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="@drawable/bg_edittext_rounded"
            android:backgroundTint="#25FFFFFF"
            android:padding="12dp"
            android:src="@drawable/ic_book_stack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvSubjectName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:ellipsize="end"
            android:gravity="right"
            android:maxLines="4"
            android:text=""
            tools:text="اسم المادة التعليمية الطويل جداً"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivSubjectIcon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edittext_rounded"
            android:backgroundTint="#33FFFFFF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="استكشاف ←"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubjectName"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>