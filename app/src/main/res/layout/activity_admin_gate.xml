<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121421"
    android:padding="30dp">

    <ImageView
        android:id="@+id/ivLock"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="80dp"
        android:src="@drawable/ic_app_logo_main"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAdminTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="الدخول الآمن للمسؤولين"
        android:textColor="#FFD700"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLock" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="يرجى إدخال الرمز السري للوصول"
        android:textColor="#A0A0A0"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAdminTitle" />

    <EditText
        android:id="@+id/etAdminPass"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="50dp"
        android:background="@drawable/bg_edittext_rounded"
        android:backgroundTint="#1F2235"
        android:gravity="center"
        android:hint="****"
        android:inputType="numberPassword"
        android:textColor="#FFD700"
        android:textColorHint="#4A4C5B"
        android:textSize="28sp"
        android:letterSpacing="0.5"
        app:layout_constraintTop_toBottomOf="@id/tvAdminTitle"
        android:layout_marginHorizontal="40dp"/>

    <Button
        android:id="@+id/btnVerifyAdmin"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="#FFD700"
        android:text="تأكيد الهوية"
        android:textColor="#121421"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etAdminPass"
        android:layout_marginHorizontal="40dp"
        app:cornerRadius="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>